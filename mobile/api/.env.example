# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=forenshield
DB_USER=postgres
DB_PASS=your_db_password
DB_ENDPOINT=
DB_SSL_MODE=prefer

# JWT Authentication
JWT_SECRET=your_new_secure_jwt_secret_key

# Third-Party API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

VT_API_KEY=your_virustotal_key

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:8000,https://app.forenshield.com
